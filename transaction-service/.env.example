# Application
NODE_ENV=development
PORT=3004

# Database — same instance/database as auth-service, own Postgres schema.
# Prisma keeps a separate _prisma_migrations table per schema, so each
# service's migration history is independent. The runtime adapter is created
# with { schema: 'transaction' } to match (see src/prisma/prisma.service.ts).
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/auth_service_db?schema=transaction"

# JWT verification — tokens are issued by auth-service (RS256). Point this at
# the public half of that service's key pair. Defaults to
# ../auth-service/keys/public.pem so a monorepo checkout works unconfigured.
# JWT_PUBLIC_KEY_PATH=

# inventory-service — confirming an order reserves stock there and
# fulfilling it posts OUT movements, forwarding the caller's own bearer token.
INVENTORY_SERVICE_URL=http://localhost:3002

# CORS
CORS_ORIGINS=http://localhost:3000

# Security
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=300
