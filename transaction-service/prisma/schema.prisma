generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Lifecycle of a sales order.
///
/// DRAFT/PENDING are the order as raised. REVIEW is the pricing gate, where
/// the special discount is settled before anyone commits to the figures, and
/// APPROVED is the sanctioned document. Only then does stock get involved:
/// CONFIRMED reserves it in inventory-service and FULFILLED converts the
/// reservation into an OUT movement.
enum OrderStatus {
  DRAFT
  PENDING
  REVIEW
  APPROVED
  CONFIRMED
  FULFILLED
  CANCELLED
  RETURNED
}

enum DiscountType {
  NONE
  PERCENT
  AMOUNT
}

/// What a footer deduction's `value` means.
enum DeductionBasis {
  PERCENT
  AMOUNT
}

/// What a PERCENT deduction is a percentage *of*. RUNNING cascades down the
/// ladder — a 5% rung after a 10% rung takes 5% of the 90% that is left, which
/// is how stacked trade terms are quoted. GROSS always uses the line subtotal.
enum DeductionBase {
  RUNNING
  GROSS
}

/// How the payable total is rounded once tax is on. NORMAL is half-up, UP and
/// DOWN always favour one side.
enum RoundingMode {
  NONE
  NORMAL
  UP
  DOWN
}

enum CustomerStatus {
  ACTIVE
  INACTIVE
}

model Customer {
  id         String         @id @default(cuid())
  tenant_id  String
  code       String?
  name       String
  phone      String?
  email      String?
  address    String?
  state      String?
  gstin      String?
  pan        String?
  status     CustomerStatus @default(ACTIVE)
  notes      String?
  attributes Json           @default("{}")
  metadata   Json           @default("{}")
  created_at DateTime       @default(now())
  updated_at DateTime       @updatedAt
  deleted_at DateTime?

  orders Order[]

  @@unique([tenant_id, code])
  @@index([tenant_id, status])
  @@index([tenant_id, name])
  @@index([tenant_id, phone])
  @@map("customers")
}

model Order {
  id          String      @id @default(cuid())
  tenant_id   String
  customer_id String
  invoice_no  String
  status      OrderStatus @default(DRAFT)
  order_date  DateTime

  subtotal Decimal @default(0) @db.Decimal(18, 4)
  /// Sum of every row in `deductions`. Derived, kept as a column so orders can
  /// be filtered and totalled on discount given without joining.
  discount       Decimal @default(0) @db.Decimal(18, 4)
  taxable_amount Decimal @default(0) @db.Decimal(18, 4)
  cgst           Decimal @default(0) @db.Decimal(18, 4)
  sgst           Decimal @default(0) @db.Decimal(18, 4)
  igst           Decimal @default(0) @db.Decimal(18, 4)
  /// Signed difference between the rounded and unrounded payable, so
  /// `total_amount` always equals the sum of its parts.
  round_off          Decimal      @default(0) @db.Decimal(18, 4)
  rounding           RoundingMode @default(NONE)
  /// The unit the total is rounded to: 1, 0.50, 0.05.
  rounding_precision Decimal      @default(1) @db.Decimal(18, 4)
  total_amount       Decimal      @default(0) @db.Decimal(18, 4)
  currency           String       @default("INR")

  notes   String?
  remarks String?

  /// Which inventory location the goods leave from; null uses the tenant default.
  location_id String?
  /// Set once stock has been reserved against this order.
  reserved_at DateTime?
  /// Set once the OUT movements have been accepted by inventory-service. Makes
  /// fulfilment idempotent.
  stock_posted_at DateTime?
  fulfilled_at    DateTime?

  /// auth-service user id of whoever raised the order.
  created_by String?
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?

  customer   Customer         @relation(fields: [customer_id], references: [id], onDelete: Restrict)
  items      OrderItem[]
  deductions OrderDeduction[]

  @@unique([tenant_id, invoice_no])
  @@index([tenant_id, status])
  @@index([tenant_id, order_date])
  @@index([customer_id])
  @@map("orders")
}

model OrderItem {
  id        String @id @default(cuid())
  tenant_id String
  order_id  String

  /// Loose reference to inventory-service `variant_sizes.id`. No foreign key:
  /// that table lives in another service's schema.
  size_id String

  /// Denormalised at write time so an invoice still prints correctly after the
  /// catalog is renamed.
  product_name String
  variant_name String
  size_label   String
  sku          String?

  quantity      Decimal      @db.Decimal(18, 4)
  rate          Decimal      @db.Decimal(18, 4)
  discount_type DiscountType @default(NONE)
  discount      Decimal      @default(0) @db.Decimal(18, 4)
  total         Decimal      @db.Decimal(18, 4)

  created_at DateTime @default(now())

  order Order @relation(fields: [order_id], references: [id], onDelete: Cascade)

  @@index([order_id])
  @@index([tenant_id, size_id])
  @@map("order_items")
}

/// One rung of the invoice footer, between the line subtotal and the taxable
/// value. An order carries as many as the deal has:
///
///   Subtotal                1,00,000
///   − Wholesale discount 10%   10,000   → 90,000
///   − Retail scheme       5%    4,500   → 85,500
///   − Trade discount      2%    1,710   → 83,790
///   = Taxable value            83,790
///
/// `code` and `label` are free text because the names are whatever the trade
/// calls them; a new scheme is a row, never a migration. This replaces the
/// discount + special_discount pair, which was already the same idea running
/// out of columns.
model OrderDeduction {
  id        String @id @default(cuid())
  tenant_id String
  order_id  String

  /// Position in the ladder. Order is part of the arithmetic, not cosmetic.
  sequence   Int
  code       String
  label      String
  basis      DeductionBasis
  applies_to DeductionBase  @default(RUNNING)
  value      Decimal        @db.Decimal(18, 4)
  /// Resolved amount. Always computed by the service, never taken from the
  /// request, so a stored order cannot disagree with its own footer.
  amount     Decimal        @db.Decimal(18, 4)

  /// Tenant-defined extras for rungs that are more than a flat percentage —
  /// an eligibility threshold, a brand scope. Validated per tenant.
  params Json @default("{}")

  created_at DateTime @default(now())

  order Order @relation(fields: [order_id], references: [id], onDelete: Cascade)

  @@unique([order_id, sequence])
  @@index([order_id])
  @@index([tenant_id, code])
  @@map("order_deductions")
}
