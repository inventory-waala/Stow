generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum PurchaseStatus {
  DRAFT
  PENDING
  ORDERED
  APPROVED
  RECEIVED
  CANCELLED
}

/// How a discount figure is to be read: a percentage of the line/bill, or a
/// flat amount in the document currency.
enum DiscountType {
  NONE
  PERCENT
  AMOUNT
}

/// What a footer deduction's `value` means.
enum DeductionBasis {
  PERCENT
  AMOUNT
}

/// What a PERCENT deduction is a percentage *of*. RUNNING cascades down the
/// ladder — a 5% rung after a 10% rung takes 5% of the 90% that is left, which
/// is how stacked trade terms are quoted. GROSS always uses the line subtotal.
enum DeductionBase {
  RUNNING
  GROSS
}

/// How the payable total is rounded once tax is on. NORMAL is half-up, UP and
/// DOWN always favour one side.
enum RoundingMode {
  NONE
  NORMAL
  UP
  DOWN
}

enum SupplierStatus {
  ACTIVE
  INACTIVE
}

model Supplier {
  id         String         @id @default(cuid())
  tenant_id  String
  code       String?
  name       String
  phone      String?
  email      String?
  address    String?
  state      String?
  division   String?
  gstin      String?
  pan        String?
  cin        String?
  status     SupplierStatus @default(ACTIVE)
  notes      String?
  /// Tenant-defined fields, same convention as inventory-service.
  attributes Json           @default("{}")
  /// Service bookkeeping; never written by tenants.
  metadata   Json           @default("{}")
  created_at DateTime       @default(now())
  updated_at DateTime       @updatedAt
  deleted_at DateTime?

  purchases PurchaseOrder[]

  @@unique([tenant_id, code])
  @@unique([tenant_id, gstin])
  @@index([tenant_id, status])
  @@index([tenant_id, name])
  @@map("suppliers")
}

model PurchaseOrder {
  id          String         @id @default(cuid())
  tenant_id   String
  supplier_id String
  invoice_no  String
  status      PurchaseStatus @default(DRAFT)
  order_date  DateTime

  subtotal Decimal @default(0) @db.Decimal(18, 4)
  /// Sum of every row in `deductions`. Derived, kept as a column so bills can
  /// be filtered and totalled on discount given without joining.
  discount       Decimal @default(0) @db.Decimal(18, 4)
  taxable_amount Decimal @default(0) @db.Decimal(18, 4)
  cgst           Decimal @default(0) @db.Decimal(18, 4)
  sgst           Decimal @default(0) @db.Decimal(18, 4)
  igst           Decimal @default(0) @db.Decimal(18, 4)
  /// Signed difference between the rounded and unrounded payable, so
  /// `total_amount` always equals the sum of its parts.
  round_off          Decimal      @default(0) @db.Decimal(18, 4)
  rounding           RoundingMode @default(NONE)
  /// The unit the total is rounded to: 1, 0.50, 0.05.
  rounding_precision Decimal      @default(1) @db.Decimal(18, 4)
  total_amount       Decimal      @default(0) @db.Decimal(18, 4)
  currency           String       @default("INR")

  notes   String?
  remarks String?

  /// Where received stock lands in inventory-service; null uses that tenant's
  /// default location.
  location_id String?
  received_at DateTime?
  /// Set once the IN movements have been accepted by inventory-service. Makes
  /// receiving idempotent: a second RECEIVED transition cannot double the stock.
  stock_posted_at DateTime?

  /// auth-service user id of whoever raised the order.
  created_by String?
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?

  supplier   Supplier            @relation(fields: [supplier_id], references: [id], onDelete: Restrict)
  items      PurchaseItem[]
  deductions PurchaseDeduction[]

  @@unique([tenant_id, invoice_no])
  @@index([tenant_id, status])
  @@index([tenant_id, order_date])
  @@index([supplier_id])
  @@map("purchase_orders")
}

model PurchaseItem {
  id          String @id @default(cuid())
  tenant_id   String
  purchase_id String

  /// Loose reference to inventory-service `variant_sizes.id` — the stockable
  /// unit. No foreign key: that table lives in another service's schema.
  size_id String

  /// Denormalised at write time. A purchase order is a historical document, so
  /// it must still print correctly after the catalog is renamed or the size is
  /// deleted.
  product_name String
  variant_name String
  size_label   String
  sku          String?

  quantity      Decimal      @db.Decimal(18, 4)
  unit_price    Decimal      @db.Decimal(18, 4)
  discount_type DiscountType @default(NONE)
  discount      Decimal      @default(0) @db.Decimal(18, 4)
  total_price   Decimal      @db.Decimal(18, 4)

  created_at DateTime @default(now())

  purchase PurchaseOrder @relation(fields: [purchase_id], references: [id], onDelete: Cascade)

  @@index([purchase_id])
  @@index([tenant_id, size_id])
  @@map("purchase_items")
}

/// One rung of the bill footer, between the line subtotal and the taxable
/// value. A bill carries as many as the deal has:
///
///   Subtotal                1,00,000
///   − Wholesale discount 10%   10,000   → 90,000
///   − Retail scheme       5%    4,500   → 85,500
///   − Trade discount      2%    1,710   → 83,790
///   = Taxable value            83,790
///
/// `code` and `label` are free text because the names are whatever the trade
/// calls them; a new scheme is a row, never a migration. `code` is the stable
/// key to report on ("trade discount given this quarter"), `label` is what
/// prints and may differ bill to bill.
model PurchaseDeduction {
  id          String @id @default(cuid())
  tenant_id   String
  purchase_id String

  /// Position in the ladder. Order is part of the arithmetic, not cosmetic.
  sequence   Int
  code       String
  label      String
  basis      DeductionBasis
  applies_to DeductionBase  @default(RUNNING)
  value      Decimal        @db.Decimal(18, 4)
  /// Resolved amount. Always computed by the service, never taken from the
  /// request, so a stored bill cannot disagree with its own footer.
  amount     Decimal        @db.Decimal(18, 4)

  /// Tenant-defined extras for rungs that are more than a flat percentage —
  /// an eligibility threshold, a brand scope. Validated per tenant.
  params Json @default("{}")

  created_at DateTime @default(now())

  purchase PurchaseOrder @relation(fields: [purchase_id], references: [id], onDelete: Cascade)

  @@unique([purchase_id, sequence])
  @@index([purchase_id])
  @@index([tenant_id, code])
  @@map("purchase_deductions")
}
