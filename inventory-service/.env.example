# Application
NODE_ENV=development
PORT=3002

# Database — same instance/database as auth-service, own Postgres schema.
# Prisma keeps a separate _prisma_migrations table per schema, so the two
# services' migration histories never collide. The runtime adapter is created
# with { schema: 'inventory' } to match (see src/prisma/prisma.service.ts).
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/auth_service_db?schema=inventory"

# JWT verification — tokens are issued by auth-service (RS256). Point this at
# the public half of that service's key pair. Defaults to ../auth-service/keys/public.pem
# so a monorepo checkout works without configuration.
# JWT_PUBLIC_KEY_PATH=

# CORS
CORS_ORIGINS=http://localhost:3000

# Security
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=300
