{
  "name": "inventory-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Inventory management monorepo with Nx orchestration",
  "workspaces": [
    "analytics-service",
    "api-gateway",
    "audit-service",
    "auth-service",
    "customer-service",
    "event-processor",
    "inventory-service",
    "notification-service",
    "organization-service",
    "product-service",
    "subscription-service",
    "transaction-service",
    "vault-service",
    "vendor-service",
    "web"
  ],
  "scripts": {
    "build": "nx run-many -t build",
    "lint": "nx run-many -t lint",
    "test": "nx run-many -t test",
    "format": "nx format:write",
    "start:auth:dev": "nx run auth-service:start:dev",
    "start:web:dev": "nx run web:dev",
    "start:inventory:dev": "nx run inventory-service:start:dev"
  },
  "devDependencies": {
    "nx": "22.7.12"
  },
  "overrides": {
    "axios": "^1.20.0",
    "smol-toml": "^1.9.0",
    "minimatch@^10": {
      "brace-expansion": "^5.0.12"
    }
  }
}
