# Application
NODE_ENV=development
PORT=3001

# Database
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/auth_service_db?schema=public"
MONGO_URI=""

# gRPC
GRPC_URL=0.0.0.0:50051

# JWT Configuration
# Optional: defaults to <service-root>/keys
# JWT_KEYS_DIR=
JWT_ACCESS_TOKEN_EXPIRY=15m
JWT_REFRESH_TOKEN_EXPIRY=7d

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Kafka
KAFKA_BROKER=localhost:9092
KAFKA_CLIENT_ID=auth-service

# Security
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100
LOGIN_RATE_LIMIT_MAX=5

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:4200

# WebAuthn
WEBAUTHN_RP_ID=localhost
WEBAUTHN_EXPECTED_ORIGIN=http://localhost:3000

# Email (transactional: verification + password reset)
# Leave MAIL_USER empty to run in log-only mode (links printed to the service log).
MAIL_SERVICE=gmail
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM="Stow <no-reply@stow.app>"
# Or explicit SMTP instead of MAIL_SERVICE:
# MAIL_HOST=smtp.example.com
# MAIL_PORT=587
# MAIL_SECURE=false

# Web app origin — used to build links in emails
APP_URL=http://localhost:3000
