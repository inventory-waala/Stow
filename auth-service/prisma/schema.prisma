// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  PENDING_VERIFICATION
  INACTIVE
  SUSPENDED
}

enum InviteStatus {
  PENDING
  ACCEPTED
  REVOKED
}

model User {
  id                String          @id @default(cuid())
  name              String?
  email             String          @unique
  password          String
  status            UserStatus @default(ACTIVE)
  is_email_verified Boolean    @default(false)
  created_at        DateTime   @default(now())
  updated_at        DateTime   @updatedAt
  authenticators    Authenticator[]
  user_roles        UserRole[]

  @@index([id])
}

model Authenticator {
  id                   String   @id @default(cuid())
  credential_id        String   @unique
  credential_public_key Bytes
  counter              BigInt
  credential_device_type String
  credential_backed_up Boolean
  transports           String?
  user_id              String
  user                 User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  created_at           DateTime @default(now())

  @@index([user_id])
}

model Roles {
  id          String   @id @default(cuid())
  tenant_id   String
  name        String
  description String?
  /// Preset roles provisioned with every tenant. They cannot be renamed or
  /// deleted, because guards and FULL_ACCESS_ROLES match on role *name*.
  is_system   Boolean  @default(false)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  tenant      Tenant           @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  user_roles  UserRole[]
  permissions RolePermission[]
  invitations Invitation[]

  @@unique([name, tenant_id])
  @@index([tenant_id])
}

model Permissions {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  roles RolePermission[]
}

model RolePermission {
  role_id       String
  permission_id String
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  role       Roles       @relation(fields: [role_id], references: [id], onDelete: Cascade)
  permission Permissions @relation(fields: [permission_id], references: [id], onDelete: Cascade)

  @@id([role_id, permission_id])
}

/// A row here *is* a tenant membership, as well as a role assignment. There is
/// deliberately no separate members table (see docs/plan.md, phase 8.5).
model UserRole {
  user_id    String
  role_id    String
  tenant_id  String
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  user   User   @relation(fields: [user_id], references: [id], onDelete: Cascade)
  role   Roles  @relation(fields: [role_id], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenant_id], references: [id], onDelete: Cascade)

  @@id([user_id, role_id, tenant_id])
  @@index([tenant_id])
}

model Tenant {
  id          String   @id @default(cuid())
  name        String
  description String?
  /// Bumped on every write that can change what a member's token says about
  /// them. An access token carries the version it was signed with, so
  /// `GET /auth/me` can tell a client its RBAC claims are stale and have it
  /// re-mint. Guards stay free of database calls.
  rbac_version Int     @default(0)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  roles       Roles[]
  user_roles  UserRole[]
  invitations Invitation[]
}

/// A pending or settled invitation to join a tenant.
///
/// Unique on (tenant_id, email): re-inviting the same address overwrites the
/// row with a fresh token rather than accumulating history.
model Invitation {
  id          String       @id @default(cuid())
  tenant_id   String
  email       String
  role_id     String
  /// sha256 of the raw token, exactly like every other token in this service.
  token       String       @unique
  invited_by  String
  status      InviteStatus @default(PENDING)
  expires_at  DateTime
  accepted_at DateTime?
  created_at  DateTime     @default(now())
  updated_at  DateTime     @updatedAt

  tenant Tenant @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  role   Roles  @relation(fields: [role_id], references: [id], onDelete: Cascade)

  @@unique([tenant_id, email])
  @@index([tenant_id, status])
}

model RefreshToken {
  id         String   @id @default(cuid())
  token      String   @unique
  user_id    String
  expires_at DateTime
  revoked    Boolean  @default(false)
  created_at DateTime @default(now())
}

model EmailVerificationToken {
  id         String   @id @default(cuid())
  token      String   @unique
  user_id    String
  expires_at DateTime
  created_at DateTime @default(now())
}

model PasswordResetToken {
  id         String   @id @default(cuid())
  token      String   @unique
  user_id    String
  expires_at DateTime
  created_at DateTime @default(now())
}

model ApiKey {
  id         String   @id @default(cuid())
  tenant_id  String
  key        String   @unique
  user_id    String
  expires_at DateTime
  created_at DateTime @default(now())
}
